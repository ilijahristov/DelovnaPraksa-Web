# Copy to .env for local development:  cp .env.example .env
# On RepoRun, set these in the Environment settings instead (never commit .env).

# ---- Required ----
POSTGRES_PASSWORD=change-me-db-password
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SEED_PROFESSOR_EMAIL=professor@example.com
SEED_PROFESSOR_PASSWORD=change-me-please

# ---- Optional (defaults shown) ----
# Only read when the database is first created; changing them later has no effect.
POSTGRES_USER=courseshub
POSTGRES_DB=courseshub
# Display name of the seeded professor (empty = "Професор")
SEED_PROFESSOR_NAME=Професор
# true = also create 2 professors, 8 students and 6 courses (demo accounts use SEED_PROFESSOR_PASSWORD)
SEED_DEMO_DATA=false
# Secure cookie flag. Leave true on RepoRun (HTTPS); docker-compose.dev.yml forces false for localhost.
COOKIE_SECURE=true
