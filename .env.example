# CoursesHub environment template
#
# Local:   copy this file to .env  (cp .env.example .env)  and adjust the values.
#          Docker Compose reads .env automatically. .env is git-ignored, never commit it.
# RepoRun: this file is NOT used there. Enter the same keys in the project's
#          Environment settings instead.

# ---- Required ----

# Password for the Postgres database. Any string works.
POSTGRES_PASSWORD=password-for-postgres

# Secret used to sign login tokens. Use a long random string, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=secret-key-for-jwt

# Professor account created on startup if no account with this email exists yet.
# "clientclient" is only for local testing: use a different password on RepoRun.
SEED_PROFESSOR_EMAIL=test.professor@example.com
SEED_PROFESSOR_PASSWORD=clientclient

# ---- Optional (values below are the defaults unless noted) ----

# Display name of that professor (default when empty: "Професор").
SEED_PROFESSOR_NAME="Test Professor"

# true = also create 2 professors, 8 students and 6 courses with links and
# enrollments (demo accounts log in with SEED_PROFESSOR_PASSWORD).
SEED_DEMO_DATA=false

# Database user and name. Only applied when the database is first created.
POSTGRES_USER=courseshub
POSTGRES_DB=courseshub

# Secure flag on the login cookie. Keep true on RepoRun (HTTPS).
# docker-compose.dev.yml forces false for http://localhost.
COOKIE_SECURE=true
